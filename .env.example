# ==========================================
# rankd — Environment Variables Template
# ==========================================
# Copy this file to .env and fill in your Supabase project credentials.
# In Vite, all client-exposed variables MUST begin with VITE_

# Your Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anon / Public API Key (from Project Settings -> API -> anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
